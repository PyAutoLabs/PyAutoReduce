__pycache__/
*.pyc
.ipynb_checkpoints/

# Reduction runtime trees — created by the scripts, never committed.
output/
cache/

# FITS files are never committed anywhere in this repo: reduced products land
# in output/<target>/, downloaded exposures in cache/. This deny + allow-list
# pattern keeps dataset/ to per-target YAML spec files (and READMEs) only —
# to ship a new non-FITS ancillary file, re-include it explicitly below.
*.fits
dataset/**
!dataset/README.md
!dataset/**/*.yaml

*.log
